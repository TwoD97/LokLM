# No HTTP listener, ACME automation, request logs, or administration UI.
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/null;
events { worker_connections 256; }
http {
    access_log off;
    server_tokens off;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    resolver 127.0.0.11 valid=10s ipv6=off;
    upstream couchdb_peer {
        zone couchdb_peer 64k;
        server couchdb:5984 resolve;
        keepalive 16;
    }
    server {
        listen 8443 ssl default_server;
        ssl_reject_handshake on;
        return 404;
    }
    server {
        listen 8443 ssl;
        server_name ${LOKLM_TLS_HOST};
        ssl_certificate /run/tls/fullchain.pem;
        ssl_certificate_key /run/tls/privkey.pem;
        ssl_session_cache shared:TLS:1m;
        ssl_session_tickets off;
        client_max_body_size 50m;
        client_body_timeout 60s;
        keepalive_timeout 65s;
        # Preserve CouchDB authentication and CORS; never enable proxy auth.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Auth-CouchDB-UserName "";
        proxy_set_header X-Auth-CouchDB-Roles "";
        proxy_set_header X-Auth-CouchDB-Token "";
        proxy_cookie_flags ~ secure httponly;
        proxy_redirect off;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 5s;
        # Exact server routes used by replication/session negotiation.
        location = / { proxy_pass http://couchdb_peer; }
        location = /_up { proxy_pass http://couchdb_peer; }
        location = /_session { proxy_pass http://couchdb_peer; }
        # The existing initializer fixes this per-instance database name.
        location ~ ^/loklm-knowledge/_(security|revs_limit|purge|compact|view_cleanup)(/|$) { return 404; }
        location = /loklm-knowledge { proxy_pass http://couchdb_peer; }
        location /loklm-knowledge/ { proxy_pass http://couchdb_peer; }
        # No Fauxton, server config, user DB, all-database listing or knowledge API.
        location / { return 404; }
    }
}
