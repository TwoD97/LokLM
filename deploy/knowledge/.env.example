# Fresh installation only. Put real values in ignored .env; never paste in chat.
APPDATA_PATH=/mnt/cache/appdata/loklm
KNOWLEDGE_PATH=/mnt/cache/loklm-knowledge
INDEX_PATH=/mnt/cache/appdata/loklm/index
LOKLM_UID=1000
LOKLM_GID=1000
LOKLM_PROFILE=standard
COUCHDB_USER=loklm-admin
COUCHDB_PASSWORD=
# Optional dedicated, fingerprint-verified model server on the private network.
# Leave unset for explicitly reported lexical-only operation.
LOKLM_EMBED_ENDPOINT=
LOKLM_MODEL_RUNTIME=
LOKLM_RERANK_ENDPOINT=
# For compose.models.yaml; files are verified before launch, never downloaded implicitly.
MODEL_PATH=/mnt/cache/appdata/loklm/models
LOKLM_EMBED_ALIAS=
LOKLM_RERANK_ALIAS=
LOKLM_ANSWER_ALIAS=
# Optional compose.gateway.yaml only; fill real hostname/paths locally.
# TLS certificate/key must be outside this checkout and outside the vault.
LOKLM_TLS_HOST=
LOKLM_TLS_CERT_FILE=
LOKLM_TLS_KEY_FILE=
# Keep loopback unless explicitly enabling a specific private LAN/VPN interface.
LOKLM_TLS_BIND=127.0.0.1
LOKLM_TLS_PORT=8443
