{
  "name": "loklm-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Landingpage für LokLM — verteilt die selbstgehosteten Installer.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test --config tests/e2e/playwright.config.ts --headed",
    "lighthouse": "lighthouse http://127.0.0.1:4321/ --preset=desktop --output=html --output=json --output-path=./.lighthouse/home --chrome-flags=--headless --quiet",
    "ci": "astro check && astro build && vitest run --coverage && playwright test --config tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.3.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.11",
    "lighthouse": "^13.5.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "devalue@<5.9.2": "^5.9.2",
      "yaml@>=2 <2.8.3": "^2.8.3",
      "source-map-js": "1.2.2"
    },
    "patchedDependencies": {
      "http-cache-semantics@4.2.0": "patches/http-cache-semantics@4.2.0.patch"
    }
  }
}
