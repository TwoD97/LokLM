---
import '@fontsource-variable/inter'
import '~/styles/global.css'
import BackgroundFx from '~/components/BackgroundFx.astro'
import Nav from '~/components/Nav.astro'
import Footer from '~/components/Footer.astro'
import { getLangFromUrl } from '~/i18n/utils'
import { currentRelease, downloadUrl } from '~/data/releases'
import {
  buildOrganizationSchema,
  buildSoftwareSchema,
  buildWebSiteSchema,
  serializeSchema,
} from '~/lib/schema'
import { resolveAlternates, type AlternatePaths } from '~/lib/alternates'
import interLatinFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'

interface Props {
  title: string
  description: string
  /** Published translation pair; home/legal routes have built-in pairs. */
  alternates?: AlternatePaths
  /** extra page-level JSON-LD objects, rendered as <script type="application/ld+json"> */
  schemas?: object[]
  /** og:type — 'website' for landing pages, 'article' for blog posts */
  ogType?: string
  /** emit robots noindex,follow (filtered/duplicate views like tag pages) */
  noindex?: boolean
}

const { title, description, alternates, schemas = [], ogType = 'website', noindex = false } =
  Astro.props
const lang = getLangFromUrl(Astro.url)
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'

const siteUrl = Astro.site!.toString().replace(/\/$/, '')
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const canonical = `${siteUrl}${pathname === '/' ? '' : pathname}`

const alt = noindex ? undefined : resolveAlternates(siteUrl, pathname, alternates)
const isHome = pathname === '/' || pathname === '/en'

const rssHref = lang === 'de' ? '/blog/rss.xml' : '/en/blog/rss.xml'

const ogLocale = lang === 'de' ? 'de_DE' : 'en_US'
const ogLocaleAlternate = lang === 'de' ? 'en_US' : 'de_DE'
const siteName = 'LokLM'

const windowsAsset = currentRelease.assets.find((a) => a.platform === 'windows' && a.available)
const winDownloadUrl = windowsAsset ? downloadUrl(windowsAsset) : undefined

const organizationSchema = buildOrganizationSchema({ siteUrl, siteName })

const websiteSchema = buildWebSiteSchema({ siteUrl, siteName, description })

const softwareSchema = buildSoftwareSchema({
  siteUrl,
  siteName,
  description,
  softwareVersion: currentRelease.version,
  winDownloadUrl,
})
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Denys Tudosa" />
    <meta name="robots" content={robots} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />

    <link rel="canonical" href={canonical} />
    {
      alt && (
        <>
          <link rel="alternate" hreflang="de" href={alt.de} />
          <link rel="alternate" hreflang="en" href={alt.en} />
          <link rel="alternate" hreflang="x-default" href={alt.xDefault} />
        </>
      )
    }
    <link rel="alternate" type="application/rss+xml" title="LokLM Blog" href={rssHref} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/app-paper.svg" />
    <link rel="mask-icon" href="/brand/mark-mono.svg" color="#0B1B2B" />
    <link rel="preload" href={interLatinFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    {alt && <meta property="og:locale:alternate" content={ogLocaleAlternate} />}
    <meta property="og:image" content={`${siteUrl}/brand/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/brand/og.png`} />
    <meta name="twitter:image:alt" content={title} />

    <meta name="theme-color" content="#0B1B2B" />

    <script
      is:inline
      type="application/ld+json"
      set:html={serializeSchema(organizationSchema)}
    />
    {
      isHome && (
        <>
          <script is:inline type="application/ld+json" set:html={serializeSchema(websiteSchema)} />
          <script is:inline type="application/ld+json" set:html={serializeSchema(softwareSchema)} />
        </>
      )
    }
    {
      schemas.map((s) => (
        <script is:inline type="application/ld+json" set:html={serializeSchema(s)} />
      ))
    }
    <slot name="head" />
  </head>
  <body class="min-h-screen relative">
    <a class="skip-link" href="#main-content">
      {lang === 'de' ? 'Zum Inhalt springen' : 'Skip to main content'}
    </a>
    <BackgroundFx />
    <div class="relative z-10">
      <Nav alternates={alt} />
      <div id="main-content" tabindex="-1" class="page-content">
        <slot />
      </div>
      <Footer />
    </div>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    background: var(--color-bg-1);
    color: var(--color-fg-0);
    font-weight: 600;
    transform: translateY(calc(-100% - 1rem));
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .page-content,
  .page-content :global([id]) {
    scroll-margin-top: 5rem;
  }
</style>
