---
import Base from '~/layouts/Base.astro'
import Hero from '~/components/Hero.astro'
import SocialProof from '~/components/SocialProof.astro'
import OpenSourceMarquee from '~/components/OpenSourceMarquee.astro'
import WhyLokLM from '~/components/WhyLokLM.astro'
import HowItWorks from '~/components/HowItWorks.astro'
import FeatureDeepDives from '~/components/FeatureDeepDives.astro'
import Features from '~/components/Features.astro'
import Architecture from '~/components/Architecture.astro'
import UseCases from '~/components/UseCases.astro'
import StartHere from '~/components/StartHere.astro'
import Download from '~/components/Download.astro'
import FAQ from '~/components/FAQ.astro'
import { t } from '~/i18n/ui'
import { faqKeys } from '~/data/faq'
import { buildFaqSchema } from '~/lib/schema'

const faqSchema = buildFaqSchema(
  faqKeys.map((k) => ({ question: t('en', k.q), answer: t('en', k.a) })),
)
---

<Base
  title="LokLM — Local AI for PDFs and your own documents"
  description="Ask questions about PDFs, Word files and notes with local AI. LokLM offers clickable citations, encrypted workspaces and offline use with local models."
  schemas={[faqSchema]}
>
  <main>
    <Hero />
    <SocialProof />
    <OpenSourceMarquee />
    <WhyLokLM />
    <HowItWorks />
    <FeatureDeepDives />
    <Features />
    <Architecture />
    <UseCases />
    <StartHere />
    <Download />
    <FAQ />
  </main>
</Base>
