---
import { getLangFromUrl } from '~/i18n/utils'
import { t } from '~/i18n/ui'

const lang = getLangFromUrl(Astro.url)
const stack = [
  { name: 'llama.cpp', url: 'https://github.com/ggml-org/llama.cpp' },
  { name: 'Hugging Face', url: 'https://huggingface.co' },
  { name: 'Whisper', url: 'https://github.com/openai/whisper' },
  { name: 'SQLite', url: 'https://www.sqlite.org' },
]
---

<section id="stack" class="stack-credit" aria-label={t(lang, 'marquee.eyebrow')}>
  <p>{t(lang, 'marquee.title')}</p>
  <ul>
    {stack.map((item) => (
      <li><a href={item.url} target="_blank" rel="noopener noreferrer">{item.name}</a></li>
    ))}
  </ul>
</section>

<style>
  .stack-credit { max-width: 72rem; margin: 0 auto; padding: 2rem 1.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem 2rem; }
  .stack-credit p { font-size: 0.9rem; color: var(--color-fg-1); }
  .stack-credit ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1.4rem; }
  .stack-credit a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-fg-1); font-size: 0.9rem; text-underline-offset: 0.25em; }
  .stack-credit a:hover { color: var(--color-accent-hover); text-decoration: underline; }
</style>
