    {
      "id": "authority-reserved-01",
      "language": "de",
      "kind": "conflicting-sources",
      "challengeCategory": "unresolved-numeric",
      "question": "Wie viele Pumpen aus Kestel-Prüflos K9 haben die Prüfung definitiv bestanden? Erläutere kurz, was die beiden Abschlussberichte belegen.",
      "requiredSourceKeys": [
        "ares-01",
        "ares-02"
      ],
      "expectedAbstention": true,
      "referenceAnswer": "Eine definitive gemeinsame Stückzahl ist nicht belegt: Der freigegebene Nord-Bericht nennt 54 und der ebenso freigegebene Süd-Bericht 57 bestandene Pumpen desselben Prüfloses, ohne dokumentierte Auflösung.",
      "answerChecks": [
        {
          "label": "Nord count",
          "pattern": "\\b54\\b"
        },
        {
          "label": "Süd count",
          "pattern": "\\b57\\b"
        }
      ],
      "allowPartial": false
    },
    {
      "id": "authority-reserved-02",
      "language": "en",
      "kind": "multi-document-comparison",
      "challengeCategory": "approved-supersession",
      "question": "On 2029-05-01, how many hand tools may an adult Aster Quay member borrow simultaneously, and why is the older limit no longer applicable?",
      "requiredSourceKeys": [
        "ares-03",
        "ares-04"
      ],
      "expectedAbstention": false,
      "referenceAnswer": "The limit is 6 hand tools: the adopted amendment effective on 2029-04-15 replaces edition 3's former limit of 4.",
      "answerChecks": [
        {
          "label": "active limit",
          "pattern": "\\b6\\b"
        },
        {
          "label": "replaced limit",
          "pattern": "\\b4\\b"
        }
      ],
      "allowPartial": false
    },
    {
      "id": "authority-reserved-03",
      "language": "en",
      "kind": "multi-document-comparison",
      "challengeCategory": "newer-unapproved",
      "question": "What annual fee currently applies to an ordinary adult Farnau music-club member, and what effect does the later budget draft have?",
      "requiredSourceKeys": [
        "ares-05",
        "ares-06"
      ],
      "expectedAbstention": false,
      "referenceAnswer": "The current fee is 84 EUR; the later draft uses 96 EUR but has not been voted on and does not change the adopted fee rules.",
      "answerChecks": [
        {
          "label": "active fee",
          "pattern": "\\b84\\b"
        },
        {
          "label": "draft fee",
          "pattern": "\\b96\\b"
        }
      ],
      "allowPartial": false
    },
    {
      "id": "authority-reserved-04",
      "language": "de",
      "kind": "multi-document-comparison",
      "challengeCategory": "different-scope-time",
      "question": "Wann beginnt der normale werktägliche Pumpentest der Rusan-Linie R2 im Januar und im Juli? Sind die beiden Zeitangaben widersprüchlich?",
      "requiredSourceKeys": [
        "ares-07",
        "ares-08"
      ],
      "expectedAbstention": false,
      "referenceAnswer": "Im Januar beginnt er um 06:30, im Juli um 08:15 Ortszeit; die gültigen Winter- und Sommerpläne betreffen verschiedene Jahreszeiten und widersprechen sich nicht.",
      "answerChecks": [
        {
          "label": "winter time",
          "pattern": "\\b0?6[:.]30\\b"
        },
        {
          "label": "summer time",
          "pattern": "\\b0?8[:.]15\\b"
        }
      ],
      "allowPartial": false
    },
    {
      "id": "authority-reserved-05",
      "language": "en",
      "kind": "table-unit",
      "challengeCategory": "equivalent-units",
      "question": "Do the acceptance sheet and commissioning log disagree about the closing duration of Elwen EV-8? State both measurements and their units.",
      "requiredSourceKeys": [
        "ares-09",
        "ares-10"
      ],
      "expectedAbstention": false,
      "referenceAnswer": "No: 90 seconds and 1.5 minutes are the same duration for the same closing cycle and test conditions.",
      "answerChecks": [
        {
          "label": "seconds",
          "pattern": "\\b90\\s*(?:seconds?|s)\\b"
        },
        {
          "label": "minutes",
          "pattern": "\\b1[.,]5\\s*(?:minutes?|min)\\b"
        }
      ],
      "allowPartial": false
    },
