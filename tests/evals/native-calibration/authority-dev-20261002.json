      "kind": "conflicting-sources",
      "challengeCategory": "unresolved-numeric",
      "question": "What final visitor-admission total is established for Leto Museum in June 2028? Briefly explain the evidence.",
      "requiredSourceKeys": [
        "adev-ledger-a",
        "adev-ledger-b"
      ],
      "expectedAbstention": true,
      "referenceAnswer": "No final total is established: the two preliminary ledgers report 980 and 1040 admissions for the same June 2028 period, and neither is approved or supersedes the other.",
